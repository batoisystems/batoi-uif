{
  "name": "@batoi/uif-icons",
  "version": "4.0.0-alpha.2",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sets": {
      "types": "./dist/sets/index.d.ts",
      "import": "./dist/sets/index.js"
    },
    "./sets/*": {
      "types": "./dist/sets/*.d.ts",
      "import": "./dist/sets/*.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/sets/index.ts src/sets/admin-security.ts src/sets/brand.ts src/sets/charts.ts src/sets/commerce.ts src/sets/communication.ts src/sets/content.ts src/sets/core-ui.ts src/sets/devices.ts src/sets/domain.ts src/sets/workflow.ts src/runtime.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@batoi/uif-dom": "4.0.0-alpha.2"
  },
  "license": "Apache-2.0"
}
