{
  "name": "@batoi/uif-profiles",
  "version": "3.0.0-alpha.2",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js"
    },
    "./rad": {
      "types": "./dist/rad.d.ts",
      "import": "./dist/rad.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility.d.ts",
      "import": "./dist/compatibility.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/all.ts src/rad.ts src/dashboard.ts src/mobile.ts src/desktop.ts src/agent.ts src/compatibility.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@batoi/uif-actions": "3.0.0-alpha.2",
    "@batoi/uif-ai": "3.0.0-alpha.2",
    "@batoi/uif-charts": "3.0.0-alpha.2",
    "@batoi/uif-components": "3.0.0-alpha.2",
    "@batoi/uif-core": "3.0.0-alpha.2",
    "@batoi/uif-dashboard": "3.0.0-alpha.2",
    "@batoi/uif-desktop": "3.0.0-alpha.2",
    "@batoi/uif-dom": "3.0.0-alpha.2",
    "@batoi/uif-editor": "3.0.0-alpha.2",
    "@batoi/uif-effects": "3.0.0-alpha.2",
    "@batoi/uif-extension-kit": "3.0.0-alpha.2",
    "@batoi/uif-forms": "3.0.0-alpha.2",
    "@batoi/uif-icons": "3.0.0-alpha.2",
    "@batoi/uif-mcp": "3.0.0-alpha.2",
    "@batoi/uif-mobile": "3.0.0-alpha.2",
    "@batoi/uif-net": "3.0.0-alpha.2",
    "@batoi/uif-overlays": "3.0.0-alpha.2",
    "@batoi/uif-push": "3.0.0-alpha.2",
    "@batoi/uif-pwa": "3.0.0-alpha.2",
    "@batoi/uif-query": "3.0.0-alpha.2",
    "@batoi/uif-rad-adapter": "3.0.0-alpha.2",
    "@batoi/uif-realtime": "3.0.0-alpha.2",
    "@batoi/uif-router": "3.0.0-alpha.2",
    "@batoi/uif-state": "3.0.0-alpha.2",
    "@batoi/uif-table": "3.0.0-alpha.2"
  },
  "license": "Apache-2.0"
}
