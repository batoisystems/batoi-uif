{
  "name": "@batoi/uif-profiles",
  "version": "4.0.0-alpha.1",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js"
    },
    "./rad": {
      "types": "./dist/rad.d.ts",
      "import": "./dist/rad.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility.d.ts",
      "import": "./dist/compatibility.js"
    },
    "./essential": {
      "types": "./dist/essential.d.ts",
      "import": "./dist/essential.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/all.ts src/rad.ts src/dashboard.ts src/mobile.ts src/desktop.ts src/agent.ts src/compatibility.ts src/essential.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@batoi/uif-actions": "4.0.0-alpha.1",
    "@batoi/uif-ai": "4.0.0-alpha.1",
    "@batoi/uif-charts": "4.0.0-alpha.1",
    "@batoi/uif-components": "4.0.0-alpha.1",
    "@batoi/uif-core": "4.0.0-alpha.1",
    "@batoi/uif-dashboard": "4.0.0-alpha.1",
    "@batoi/uif-desktop": "4.0.0-alpha.1",
    "@batoi/uif-dom": "4.0.0-alpha.1",
    "@batoi/uif-editor": "4.0.0-alpha.1",
    "@batoi/uif-effects": "4.0.0-alpha.1",
    "@batoi/uif-extension-kit": "4.0.0-alpha.1",
    "@batoi/uif-forms": "4.0.0-alpha.1",
    "@batoi/uif-icons": "4.0.0-alpha.1",
    "@batoi/uif-mcp": "4.0.0-alpha.1",
    "@batoi/uif-mobile": "4.0.0-alpha.1",
    "@batoi/uif-net": "4.0.0-alpha.1",
    "@batoi/uif-overlays": "4.0.0-alpha.1",
    "@batoi/uif-push": "4.0.0-alpha.1",
    "@batoi/uif-pwa": "4.0.0-alpha.1",
    "@batoi/uif-query": "4.0.0-alpha.1",
    "@batoi/uif-rad-adapter": "4.0.0-alpha.1",
    "@batoi/uif-realtime": "4.0.0-alpha.1",
    "@batoi/uif-router": "4.0.0-alpha.1",
    "@batoi/uif-state": "4.0.0-alpha.1",
    "@batoi/uif-table": "4.0.0-alpha.1"
  },
  "license": "Apache-2.0"
}
